{
  "name": "deutschraum-gym-engine",
  "version": "0.2.1",
  "private": true,
  "description": "Motor sin interfaz de Deutschraum Gym (etapas 2 y 2b)",
  "scripts": {
    "bundle": "node tools/bundle.js",
    "test": "node tools/bundle.js && node --test --test-reporter=spec --test-concurrency=1 \"tests/*.test.js\"",
    "test:fast": "node --test --test-reporter=spec --test-concurrency=1 --test-skip-pattern=SIM \"tests/*.test.js\"",
    "sim": "node sim/simulate.js",
    "build:ui": "node tools/build.js"
  },
  "devDependencies": {
    "jsdom": "^31.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
